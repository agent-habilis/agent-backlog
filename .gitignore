.DS_Store

# This repo's own board. It is the dogfooding board for developing the tool,
# not something to ship to anyone who clones it — a fresh checkout should start
# at `/backlog init`, not inherit our tasks.
#
# A board in a normal project belongs *in* git: that is what makes a move show
# up as a rename and `git log --follow` say when it happened.
.agent-backlog/

# Scratch files `bun build --compile --target` leaves beside the outfile.
.*.bun-build
